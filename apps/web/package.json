{
  "name": "@agent-kanban/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm server\" \"pnpm client\"",
    "server": "AK_PORT=${AK_API_PORT:-8787} tsx server/node/cli.ts",
    "client": "vite dev",
    "prebuild": "pnpm --filter @agent-kanban/shared build && pnpm --filter agent-kanban build && mkdir -p public/cli && cp ../../packages/cli/dist/standalone.js public/cli/ak-standalone.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm server",
    "db:migrate": "tsx server/database/migrate-cli.ts",
    "db:reset": "rm -f \"${AK_DATABASE_PATH:-$HOME/.local/share/agent-kanban/agent-kanban.sqlite}\" && pnpm db:migrate",
    "local:migrate": "tsx server/database/importD1-cli.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-kanban/shared": "workspace:*",
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@base-ui/react": "^1.3.0",
    "@better-auth/agent-auth": "^0.4.5",
    "@better-auth/api-key": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.96.2",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.16",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "openpgp": "^6.3.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-diff-viewer-continued": "^4.2.0",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.10",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}
